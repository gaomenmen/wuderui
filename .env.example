# WuDeRuiBo Environment Variables
# Copy this file to .env and fill in your values

# ── Required for Production ──
# Random 32+ character string for session encryption
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string

# PostgreSQL connection string (production only)
# SQLite is used automatically if DATABASE_URL is not set
DATABASE_URL=postgresql://user:password@localhost:5432/wuderui

# ── Optional ──
# Flask debug mode (default: false in production)
# FLASK_DEBUG=false

# Admin credentials for initial setup (optional, defaults to admin/changeme123)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=changeme123
